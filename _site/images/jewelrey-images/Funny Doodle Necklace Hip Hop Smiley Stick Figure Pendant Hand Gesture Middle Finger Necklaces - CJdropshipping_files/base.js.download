              'height': '100px',
              'width': '100px',
              'z-index': '100'
            }).appendTo($('body')).animate({
              'top': cart.offset().top + 10,
              'left': cart.offset().left + 10,
              'width': 75,
              'height': 75
            }, 500);
            imgclone.animate({
              'width': 0,
              'height': 0
            }, function () {
              $(this).detach();
            });
          }
        });
        if (fromType == 'CommentList') {
          dsp.postFun('cj/appPush/updatePushProductsCollect', {
            "productid": id,
            "collectionCount": 1,
            "push_id": push_id
          }, function (res) {
            console.log(res);
          });
        }
      } else {
        selectData.flag = '1';
