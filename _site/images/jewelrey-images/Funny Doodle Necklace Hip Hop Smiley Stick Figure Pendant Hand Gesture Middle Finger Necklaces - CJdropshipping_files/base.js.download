  function noInvoiceTip() {
    // <a href="javascript:void(0);" class="re-submit">Cancel</a>
    layer.open({
      title: 'Consignee not found, unble to generate invoice.',
      type: 1,
      area: ['480px', '300px'],
      skin: 'no-invoice-tip',
      closeBtn: 1,
      content: '<div class="NIT-con"><img class="invoice-icon" src="/static/image/public-img/ticket_invoice.png" alt="" /><a  class="go-set">Setup Now</a></div>',
      btn: ['Cancel'],
      success: function success(layero, index) {
        $(layero).find('.go-set').click(function () {
          layer.close(index);
          window.open('/my.html#/profile/invoice');
        });
      },
      yes: function yes(index, layero) {
        layer.close(index);
      },
      cancel: function cancel(index, layero) {
        layer.close(index);
      }
    });
  }

  /** 是否弹窗去设置发票抬头 */
  function isinvoiceDialog(postFun) {
    return function (id, type) {
      var msgLoading = cjMessage.loading({
        isFixed: true
      });
      if (type == 'VIDEOPAY') {
        postFun('tool/invoiceBill/getInvoiceBillByVideoDownloadId', {
          'orderId': id,
          'flag': type
        }, function (res) {
          msgLoading.hide();
          if (res.data.statusCode == 901) {
            noInvoiceTip();
            // isHref = 2;
          } else {
            window.open("invoice.html?id=".concat(id, "&type=").concat(type));
            // isHref = 1;
          }
        }, function (res) {
          msgLoading.hide();
        });
      } else {
        postFun('tool/invoiceBill/getInvoiceBillByOrderId', {
          'orderId': id,
          'flag': type
        }, function (res) {
          msgLoading.hide();
          if (res.data.statusCode == 901) {
            noInvoiceTip();
            // isHref = 2;
          } else {
            location.href = 'invoice.html?id=' + id + '&type=' + type;
            // isHref = 1;
          }
        }, function (res) {
          msgLoading.hide();
        });
      }
    };
  }

  /** 
   * @deprecated 已弃用
   * wall-invoice 
   * */
  function iswallInvoiceDialog(postFun) {
    return function (startTime, endTime, exportType) {
      layer.load(2);
      postFun('userCenterForeignWeb/invoice/getInvoiceHeaderList', {}, function (res) {
        layer.closeAll('loading');
        if (res.data.data.length > 0) {
          location.href = 'wallet-invoice.html?startTime=' + startTime + '&endTime=' + endTime + '&exportType=' + exportType;
        } else {
          noInvoiceTip();
        }
      }, function (res) {
        layer.closeAll('loading');
      }, {
        headers: {
          // platform: '2'
        }
      });
    };
  }
});

