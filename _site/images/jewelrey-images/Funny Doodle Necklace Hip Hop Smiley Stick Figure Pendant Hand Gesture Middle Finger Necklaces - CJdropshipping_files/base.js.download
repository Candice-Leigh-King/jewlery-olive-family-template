          $scope.$emit('store-search', $scope.searchMerchName);
        };
        $scope.conTactFun = function () {
          window.postMessage({
            flag: 'openChat',
            supplierId: $scope.shopData.supplierId,
            shopName: $scope.shopData.name
          }, '*');
        };
        $scope.isSearchImage = dsp.getQueryString('searchImg');
        cjUtils.addListenGetFilesForDragOver({
          elemId: 'searchImgBox',
          ondrop: function ondrop(files) {
            searchImg(files[0]);
          }
        });
        $scope.upLoadImg = function (files) {
          var file = files[0];
          searchImg(file);
        };
        $scope.evalute = [{
          desc: 'Item as Described',
          number: 0
        }, {
          desc: 'Communication',
          number: 0
        }, {
          desc: 'Shipping Speed',
          number: 0
        }];
        $scope.$on('shop_data', function (d, data) {
          $scope.shopData = {
            name: data.name,
            id: data.id,
            supplierId: data.supplierId,
            logo: data.logo
          };
          if ($scope.shopData.supplierId) {
            dsp.postFun('cjEvaluation/getSupplierGrade', {
              supplierId: data.supplierId
            }, function (res) {
              if (res.status === 200 && res.data.code === 200) {
                $scope.evalute = [{
                  desc: 'Item as Described',
                  number: res.data.data.avgGoodMatch
                }, {
                  desc: 'Communication',
                  number: res.data.data.avgAnswerSpeed
                }, {
                  desc: 'Shipping Speed',
                  number: res.data.data.avgDeliverySpeed
                }];
              }
            });
          }
        });
        /**
         * 清除图片数据
         */
        $scope.imgClear = function () {
          localStorage.removeItem('_search_pic_');
          $scope.imgArr = undefined;
        };
        getSearchImg();
        getShoppingCartNum();
        $scope.toMyList = function () {
          if ($scope.hasLogin) {
            location.href = '/my.html#/products-connection/history/0?track=10';
          } else {
            location.href = "/login.html?target=".concat(bs.encode('/my.html#/products-connection/history/0?track=10'));
          }
        };
        $scope.toShoppingCart = function () {
          if ($scope.hasLogin) {
            location.href = '/mine/purchase/purchaseCart';
          } else {
            location.href = "/login.html?target=".concat(bs.encode('/mine/purchase/purchaseCart'));
          }
        };
        /* 菜单埋点 */
        $scope.addStatisFun = function (type, ev) {
          dsp.postFun('pojo/home/addStatisByType', {
            entryPage: type
          }, function (res) {
            console.log(res.data);
          });
        };

        // 隐藏显示
        // 消息通知

        $scope.MessageType = '1';
        $scope.UrlId = '';
        $scope.CJ = '';
        $scope.Elites = '';
        $scope.recommend = '';
        $scope.messagePre = [];
        $scope.isMark = true;
        $scope.messageTab = [{
          name: 'From CJ',
          active: 'true',
          val: '1',
          count: 0
        }, {
          name: 'ELITES',
          active: 'false',
          val: '2',
          count: 0
        }, {
          name: 'Recommendations',
          active: 'false',
          val: '3',
          count: 0
        }];
        $scope.checkMessage = function (item) {
          for (i = 0; i < $scope.messageTab.length; i++) {
            $scope.messageTab[i].active = 'false';
          }
          item.active = 'true';
          $scope.MessageType = item.val;
          $scope.isMark = true;
          getMessage();
          // console.log($scope.messagePre)
        };

        //消息中心
        //消息中心鼠标移入移出
        $scope.toggleMessage = function (bool) {
          $scope.isTopFlag = bool;
        };
        $scope.toAllMessage = function () {
          // window.open('/my.html#/all-message?'+$scope.MessageType)
          // location.href = '/my.html#/all-message?'+$scope.MessageType
          location.href = '/my.html#/all-message/' + $scope.MessageType;
          // $state.go ('/my.html#/all-message', { id: $scope.MessageType } )
        };
        $scope.toMarkAll = function () {
          if ($scope.MessageType == '1') {
            dsp.postFun('messageCenterCj/notification/updateRead', {
              userId: $scope.userId
            }, function (data) {
              if (data.data.code == 200) {
                getCount();
                getMessageCJ();
              }
            });
          } else if ($scope.MessageType == '2') {
            dsp.postFun('cujia-message/cj/notification/allRead', {}, function (data) {
              if (data.data.statusCode == 200) {
                getCount();
                getMessageElites();
              }
            });
          } else if ($scope.MessageType == '3') {
            dsp.postFun('cj/appPush/updateAppPushIsRead', {}, function (data) {
              if (data.data.statusCode == 200) {
                getCount();
                getMessageComment();
              }
            });
          }
        };
        $scope.toAnother = function (item) {
          if ($scope.MessageType == '2') {
            $scope.UrlId = item.detail_id;
            var otime = new Date().getTime();
            if (item.operation_type == '1') {
              window.open("https://elites.cjdropshipping.com/cross?token=".concat($scope.token, "&_t=").concat(otime, "&url=/personal-index?id=").concat(item.user_id, "&page=other")); //关注
            }
            if (item.operation_type == '4' || item.operation_type == '6' || item.operation_type == '9' || item.operation_type == '10') {
              window.open("https://elites.cjdropshipping.com/cross?token=".concat($scope.token, "&_t=").concat(otime, "&url=/question-detail?id=").concat(item.detail_id)); //问题
            }
            if (item.operation_type == '3' || item.operation_type == '7') {
              window.open("https://elites.cjdropshipping.com/cross?token=".concat($scope.token, "&_t=").concat(otime, "&url=/question-detail?id=").concat(item.question_id)); //问题
            }
            if (item.operation_type == '2' || item.operation_type == '5' || item.operation_type == '8') {
              window.open("https://elites.cjdropshipping.com/cross?token=".concat($scope.token, "&_t=").concat(otime, "&url=/article-detail?id=").concat(item.detail_id)); //文章详情
            }
          } else if ($scope.MessageType == '3') {
            location.href = '/list-detail.html?id=' + item.push_id + '&fromType=CommentList';
          }
        };
        var isOnline = dsp.NODE_ENV === 'production' || dsp.NODE_ENV === 'production-cn';
        $scope.$on('msgBarRendered', function (ev) {
          // 在节点加载后执行
          new CJMsg({
            isLogin: $scope.hasLogin,
            getDomainByUrl: dsp.getDomainByUrl
          });
        });
        $scope.warehouseList = [];
        var wareareal = sessionStorage.getItem('wareareal');
        if (wareareal) {
          // 判断是否是线上环境
          $scope.warehouseList = temp.map(function (t) {
            return _objectSpread(_objectSpread({}, t), {}, {
              countryUrl: isOnline ? "https://".concat(t.countryCode.toLowerCase(), ".cjdropshipping.com") : "http://".concat(t.countryCode.toLowerCase(), ".test.com"),
              image: t.image ? t.image : "/egg/image/home/flag/".concat(t.countryCode, ".png")
            });
          });
          $scope.$emit('warearea-list', temp);
        } else {
          getWare();
        }
        $scope.chatsupply = function () {
          var supplyid = $scope.shopData.supplierId;
          window.postMessage({
            flag: 'chat-supplier',
            supplierName: $scope.shopData.name,
            supplierId: supplyid
          }, '*');
        };
      } catch (error) {
        console.warn(error);
        //  location.href = 'error.html';
      }
    }
    comHeader.directive('onFinish', ['$timeout', function ($timeout) {
      // 节点加载后执行
      return {
        restrict: 'A',
        link: function link(scope, element, attr) {
          $timeout(function () {
            scope.$emit('msgBarRendered'); // 这里执行msgBarRendered
          });
        }
      };
    }]);
  })(angular);
});

