        // 接口文档 http://192.168.5.222/project/454/interface/api/64068
        var load = cjMessage.loading({
          isFixed: true
        });
        $scope.listLoading = true;
        dsp.getFun('cj-platform-web/product/listedProductTemplate/listTemplate', function (res) {
          load.hide();
          $scope.listLoading = false;
          if (res.data.success) {
            $scope.templateList = res.data.data;
          } else {
            $scope.templateList = [];
          }
        }, function () {
          load.hide();
          $scope.listLoading = false;
        });
      };

      // 点击删除模板
      $scope.listedTemplateId = '';
      $scope.deleteClick = function (item) {
        $scope.pop_ups = true;
        $scope.listedTemplateId = item.listedTemplateId;
      };

      // 点击添加模板
      $scope.addClick = function () {
        $('.cj-tooltip-padding').hide();
        if ($scope.templateList.length >= 5) {
          return layer.msg('You can add 5 templates at most. Please contact your agent for help.');
        }
        $scope.editItem = undefined;
        $scope.isAdd = true;
      };

      // 点击编辑模板
      $scope.editItem = {};
      $scope.editClick = function (item) {
        $('.cj-tooltip-padding').hide();
        $scope.editItem = item;
        $scope.isAdd = true;
      };

      // 点击返回
      $scope.backClick = function () {
        $scope.isAdd = false;
      };

