            $scope.commodityDetails.stanProducts.forEach(function (variant) {
              var matchVariant = $scope.detailInfoVariants.find(function (item) {
                return item.ID === variant.ID;
              });
              if (matchVariant) {
                variant.canList = matchVariant.canList; // 是否可以刊登
              }
            });
            callback();
          }
        }, function (err) {
          msgLoading.hide();
        });
      };

