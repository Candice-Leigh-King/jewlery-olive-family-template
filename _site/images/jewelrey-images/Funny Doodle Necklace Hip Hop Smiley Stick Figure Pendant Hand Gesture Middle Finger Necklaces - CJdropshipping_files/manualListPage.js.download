            array[i].rateConverted = null;
            if (price < $scope.realTimeExchange && $scope.store.TYPE == 'etsy') {
              array[i].price = (+$scope.realTimeExchange + 0.01).toFixed(2);
            } else if (price && array.length > 0 && +price < +array[i].DropshippingPrice && !['shopee', 'temu_us_local'].includes($scope.shopType)) {
              layer.msg("Store price is lower than ".concat(siteName, " price. Please confirm."));
