      $scope.addTag = function () {
        var val = $scope.tapitem;
        var list = $scope.taps;
        if (val) {
          if ($scope.store && $scope.store.TYPE == 'allvalue' && val.length > 64) return;
          if (($scope.store && $scope.store.TYPE != 'allvalue' || !$scope.store) && val.length > 20) return;
          for (var i = 0; i < list.length; i++) {
            if (val === list[i]) return;
          }
          if (list.length >= 7) return layer.msg('7 tags at most.');
          $scope.taps.push(val.trim());
          $scope.tapitem = '';
        } else {
          layer.msg('Please enter a tag');
