        item.check = !item.check;
        var checkLen = $scope.listArr.filter(function (o) {
          return o.check;
        }).length;
        $scope.check_All = $scope.listArr.length === checkLen;
        if (item.check) {
          $scope.checkNum = 0;
          for (var i = 0; i < $scope.listArr.length; i++) {
            if ($scope.listArr[i].check) {
              $scope.checkNum++;
              if ($scope.checkNum > 50 && type == 'magento') {
                item.check = false;
                $scope.checkNum = 50;
                return layer.msg('You can only list 50 variants once at most. Please select no more than 50 variants on the product page.');
