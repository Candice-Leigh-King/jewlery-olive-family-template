      /** 获取shopify店铺-类目 */
      function handleShopify(shopId) {
        dsp.getFun('cj-platform-web/product/queryTypesOld?shopId=' + shopId, function (data) {
          var result = data.data.result ? utils.JSONparse(data.data.result) : [];
          $scope.categoryList = result.map(function (item) {
            item.name = item.product_type; // 统一店铺名称 name 字段，方便模版取值
            item.label = item.product_type;
            item.value = item.product_type;
