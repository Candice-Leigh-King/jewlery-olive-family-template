      $scope.publishedMethod = "ASC";
      var changeSiteCode = function changeSiteCode() {
        $scope.shopSiteCode = $scope.publishedMethod === 'ASC' ? $scope.lazadaCountry : 'my'; // 店铺站点
      };
      $scope.selectPublishedMethod = function () {
        if ($scope.publishedMethod === 'GSP') {
          $scope.CurrencyCode = 'USD';
          $scope.GetExchangeRate();
          $scope.lazadaStationList = $scope.lazadaStationList.map(function (item) {
            item.checked = true;
            return item;
          });
          $scope.showLazadaStation = true;
          $scope.lazadaCountry = 'my';
          // getLazadaCategory(function (data) {
          //   assembleLazadaCate({ menus: data, type: 'init' })
          // });
        } else {
          $scope.showLazadaStation = false;
        }
        if ($scope.CurrencyCode != 'USD') {
          $scope.showDollar = false;
        } else {
          $scope.showDollar = true;
        }
        changeSiteCode();
      };

      // 初始化站点的选择信息
      function initStationState() {
        $scope.showLazadaStation = false;
        $scope.publishedMethod = "ASC";
        $scope.variationTrue = [];
        $scope.variantsName = [];
        $scope.vendorList = [];
        $scope.showDollar = true;
      }

      // 获取站点选择的列表
      function getLazadaStationList() {
        var url = "cj-platform-web/shop/country/queryCountryList?platform=LAZADA";
        dsp.getFun(url, function (res) {
          var data = res.data;
