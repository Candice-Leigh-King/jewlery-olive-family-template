          $scope.listArr.forEach(function (e) {
            e.price = '';
            e.currencyUnit = '';
            e.rateConverted = '';
          });
        }
        if ($scope.CurrencyCode === 'USD') {
          $scope.defaultCurrencyConverted = 1;
          $scope.realTimeExchange = ($scope.defaultCurrencyConverted * $scope.amountLimit).toFixed(2);
