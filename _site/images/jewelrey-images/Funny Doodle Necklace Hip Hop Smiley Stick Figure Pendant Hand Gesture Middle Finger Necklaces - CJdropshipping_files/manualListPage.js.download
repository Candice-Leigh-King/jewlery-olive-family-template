            array[_i19].price = (+$scope.realTimeExchange + 0.01).toFixed(2);
          } else if (+array[_i19].rateConverted < +array[_i19].DropshippingPrice && !['shopee', 'temu_us_local'].includes($scope.shopType)) {
            layer.msg("Store price is lower than ".concat(siteName, " price. Please confirm."));
            return;
          }
        }
      }

