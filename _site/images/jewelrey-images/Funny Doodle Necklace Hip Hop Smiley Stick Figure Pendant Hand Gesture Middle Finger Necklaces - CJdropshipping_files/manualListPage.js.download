      // 获取外部传入的动态变量
      this.$onChanges = function (data) {
        if (data.hideSamePriceSet) {
          $scope.moduleShow.noPrice = data.hideSamePriceSet.currentValue ? false : true;
        }
      };
    }
  })(angular);
});

