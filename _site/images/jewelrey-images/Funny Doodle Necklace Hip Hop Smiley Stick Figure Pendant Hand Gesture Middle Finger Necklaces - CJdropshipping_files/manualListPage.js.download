          }
          if (type == 'ebay' && o.inventory == 0 || $scope.isNotAllowedCheckSKU(o) || !$scope.canConnectVariant(o)) {
            o.check = false;
          }
        });
        if ($scope.check_All) {
          $scope.checked = [];
          $scope.checkNum = $scope.listArr.filter(function (e) {
            return e.check == true;
          }).length;
          if ($scope.listArr.length > 50 && type == 'magento') {
            $scope.magentoListLimit();
          } else if ($scope.listArr.length > 99) {
            layer.msg('You can only list 99 variants once at most. Please select no more than 99 variants on the product page. ');
          }
        } else {
          $scope.checkNum = 0;
        }
