      $scope.$on('list-template-show', function (d, data) {
        getListTemplate();
        $scope.show = true;
      });
      $scope.listTemplateHide = function () {
        $scope.show = false;
        $scope.isAdd = false;
        $scope.$emit('list-template-hide-callback');
      };

      // 删除确认弹窗
      $scope.$on('closePopUps', function (e, data) {
        $scope.pop_ups = data.showPopUps;
      });
      $scope.$on('confirmPopUps', function (e, data) {
        dsp.postFun('cj-platform-web/product/listedProductTemplate/deleteTemplate', {
          listedTemplateId: $scope.listedTemplateId
        }, function (res) {
          console.log(res, 'asdasdasd');
          if (res.data.success) {
            getListTemplate();
