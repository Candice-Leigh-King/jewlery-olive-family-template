      /** 获取ebay店铺upc信息 */
      function getEbayCodeRuquire(cataInfo) {
        $scope.requiredCode = {};
        $scope.requiredCodeLen = 0;
        $scope.isVariant = false;
        var msgLoading = cjMessage.loading({
          isFixed: true
        });
        var categoryId = cataInfo.categoryId || "";
        var shopId = $scope.store.ID || "";
        var siteCode = $scope.ebayCountry || "";
        var FeatureListUrl = "cj-platform-web/product/category/getCategoryFeatureList?categoryId=".concat(categoryId, "&shopId=").concat(shopId, "&siteCode=").concat(siteCode, "&platform=").concat($scope.platform);
        dsp.getFun(FeatureListUrl, function (res) {
          msgLoading.hide();
          var data = res.data;
          //5000是请求参数错误
          if (data.code == 5000) return;
          if (data.data !== null) {
            if (data.data.length == 0) {
              // layer.msg("Variants cannot be listed in this category. Please choose another category.");
              $scope.isVariant = false;
              disableEbayCategory({
                categoryId: categoryId
              });
            }
            if (data.data[0].upcEnabled === 'REQUIRED') {
              $scope.requiredCode.UPC = '';
            }
            if (data.data[0].eanEnabled === 'REQUIRED') {
              $scope.requiredCode.EAN = 'Does not apply';
              $scope.othersParam.EAN = 'Does not apply';
            }
            if (data.data[0].isbnEnabled === 'REQUIRED') {
              $scope.requiredCode.ISBN = 'Does not apply';
              $scope.othersParam.EAN = 'Does not apply';
            }
            $scope.isVariant = data.data[0].isVariant ? data.data[0].isVariant : ''; // 类目是否支持变体
          } else {
            // layer.msg("Variants cannot be listed in this category. Please choose another category.");
            $scope.isVariant = false;
            disableEbayCategory({
              categoryId: categoryId
            });
          }
          $scope.requiredCodeLen = Object.keys($scope.requiredCode).length;
          //传入requiredCodeLenkey到othersParam初始参数
          for (var key in $scope.requiredCode) {
            $scope.othersParam[key] = '';
          }
          getCategorySpecificsList(cataInfo);
        }, function (err) {});
      }
      //eBay属性
      $scope.eBayAttr = [];
      $scope.variationTrue = [];

      // 修改类目时的clear方法
      $scope.changeCateClear = function () {
        clearEbayError();
        $scope.showBulkYourAttrValue = false;
        $scope.variantsName = [];
        $scope.bulkYourValue = '';
        $scope.bulkYourValueId = '';
        $scope.bulkRevise = $scope.shopType == 'mercado' ? 'inventory' : 'price';
        $scope.ebayCategoryID = '';
        $scope.ebayMenus = [];
        $scope.tikTokDefaultCategoryList = [];
        $scope.ebayCategoryArrayID = [];
        $scope.categoryIsLast = false;
        $scope.ebayCategoryID = undefined;
