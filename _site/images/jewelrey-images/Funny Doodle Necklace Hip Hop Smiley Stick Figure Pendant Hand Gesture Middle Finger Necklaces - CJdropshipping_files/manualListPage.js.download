              if (res.data.success) {
                getListTemplate();
                $scope.isAdd = false;
              } else if (res.data.code == 401) {
                layer.msg('You have an invalid store, please select stores again.');
              } else {
                layer.msg(res.data.message);
              }
            });
          }
        });
