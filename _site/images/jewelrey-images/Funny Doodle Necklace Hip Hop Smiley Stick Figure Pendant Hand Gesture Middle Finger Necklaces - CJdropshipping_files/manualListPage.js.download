      // 获取价格规范
      function getPrice(value) {
        var price = value.replace(/^\./, '0.').replace(/[^\d^\.]+/g, '').replace('.', '$#$').replace(/\./g, '').replace('$#$', '.').replace(/^(\-)*(\d+)\.(\d\d).*$/, '$1$2.$3');
