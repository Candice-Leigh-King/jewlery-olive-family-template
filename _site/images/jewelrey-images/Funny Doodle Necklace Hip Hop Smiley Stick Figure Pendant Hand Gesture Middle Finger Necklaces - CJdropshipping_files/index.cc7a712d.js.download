lers":"Confiance des vendeurs 4M","vs-sv-what-do-other-dropshippers-say":"Que disent les autres Dropshippers?","wallet-affiliate-withdrawal":"Retrait d\'affilié","wallet-all":"Tous","wallet-approved":"Approuvé","wallet-cancel":"Retirer","wallet-charging-benefit":"Prestation de charge","wallet-confirm":"Confirmer","wallet-export":"L\'exportation","wallet-generate-invoice":"Générer une facture","wallet-if-you-want-to-apply-for-credit-line-again-please-contact-your-agent.":"Si vous souhaitez demander à nouveau une ligne de crédit, veuillez contacter votre agent.","wallet-order-payment":"Paiement de la commande","wallet-order-refund":"Remboursement de la commande","wallet-order-refund-out-of-stock":"Remboursement de la commande: en rupture de stock","wallet-paid-sourcing":"Sourcing payant","wallet-payment-method":"Méthode de paiement","wallet-rejected":"Rejeté","wallet-system-deduction":"Déduction du système","wallet-system-refund":"Remboursement système","wallet-time":"Temps:","wallet-top-up-upper":"En plus","wallet-top-up-with-gift-card":"Top-up avec Carte Cadeau","wallet-under-review":"En cours d\'examen","wallet-withdrawal":"Retrait","warehouse-discount":"Livraison gratuite","warehouse-header-account":"Compte","warehouse-header-blog":"Blogue","warehouse-header-elites":"ELITES","warehouse-header-help-center":"Center d\'aide","warehouse-header-logout":"Déconnectez-vous","warehouse-header-profile":"Profil","warehouse-header-rating":"Note ({{supplierCount}})","warehouse-header-shipping-calculate":"Calcul de l\'expédition","warehouse-header-ticket":"Billet","warehouse-header-tool":"Outil","warehouse-header-track-order":"Suivre les commandes","warehouse-header-wallet":"Portefeuille","warehouse-product-type1":"Vidéos du produit","warehouse-product-type2":"Produits fournisseur"}');

